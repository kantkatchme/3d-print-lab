# Copy to .env and fill in. Never commit the real file.

# Home Assistant REST API
HA_URL=http://homeassistant.local:8123/api
HA_TOKEN=                      # long-lived access token (or put it in ~/.ha-token / HA_TOKEN_FILE)

# Printer
PRINTER_IP=192.168.1.50        # for the MJPEG camera stream (port 8080)
PRINTER_PREFIX=carbon_2_combo  # entity prefix of the Elegoo CC2 integration
STATUS_SENSOR=druckstatus      # localised: German HA = druckstatus, English HA = print_status
ERROR_SENSOR=druckfehler       # localised: German HA = druckfehler, English HA = print_error

# Alerts (all optional; without NOTIFY_CMD alerts are printed to stdout)
NOTIFY_CMD=                    # called as: <cmd> <red|yellow|info> <title> <text>
GUEST_NOTIFY_CMD=              # second channel for housemates, called as: <cmd> <title> <text>
TTS_ENTITIES=                  # comma separated HA notify entities, e.g. notify.living_room_tts

# AI guard
CLAUDE_BIN=claude
GUARD_MODEL_FAST=claude-haiku-4-5-20251001
GUARD_MODEL_STRONG=claude-sonnet-5-5
PRINTLAB_STATE=                # state folder, default ~/.printlab
ALARM_DIR=                     # where YELLOW/RED frames are kept, default <state>/alarms

# Filament demand
PRINT_DIR=.                    # folder with queue/<person>/<project>/*.gcode and filament-stock.md
